{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Минимальные права: окно ядра, буфер обмена и открытие ровно тех ссылок, что есть на экране поддержки. Никакого shell, fs, http.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-content-protected",
    "core:window:allow-set-title",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://boosty.to/*" },
        { "url": "bitcoin:*" },
        { "url": "ethereum:*" },
        { "url": "monero:*" },
        { "url": "tron:*" }
      ]
    }
  ]
}
